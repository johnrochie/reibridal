# ── Sanity CMS ──────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# ── Appointment booking ─────────────────────────────────────
# Optional. If set, the appointments page embeds this scheduler
# (Calendly / Cal.com inline URL). If unset, the built-in
# enquiry form is shown instead.
NEXT_PUBLIC_BOOKING_EMBED_URL=

# ── Enquiry form delivery (pick one) ────────────────────────
# Option A: Resend (https://resend.com) — sends enquiries by email
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=info@reibridal.ie
ENQUIRY_TO_EMAIL=info@reibridal.ie

# Option B: generic webhook (Zapier, Make, Slack, etc.)
ENQUIRY_WEBHOOK_URL=

# ── Image storage (optional production providers) ───────────
# Catalogue records store provider + key; the site resolves URLs at render time.
# Leave unset to use Sanity assets and/or local sample images in /public/images.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_S3_PUBLIC_BASE_URL=
NEXT_PUBLIC_IMAGE_CDN_HOSTNAME=
NEXT_PUBLIC_LOCAL_MEDIA_BASE=/images

# ── Site-wide coming-soon hold ──────────────────────────────
# true  = placeholder on every environment (useful for local checks)
# false = full site even on the production domain
# unset = hold on the production domain and on Vercel Production;
#         preview, localhost, and *.vercel.app previews keep the working site
COMING_SOON=
