# ── Sanity CMS ──────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# ── Appointment booking ─────────────────────────────────────
# Optional. If set, the appointments page embeds this scheduler
# (Calendly / Cal.com inline URL). If unset, the built-in
# enquiry form is shown instead.
NEXT_PUBLIC_BOOKING_EMBED_URL=

# ── Enquiry form delivery (pick one) ────────────────────────
# Option A: Resend (https://resend.com) — sends enquiries by email
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=enquiries@reibridal.ie
ENQUIRY_TO_EMAIL=hello@reibridal.ie

# Option B: generic webhook (Zapier, Make, Slack, etc.)
ENQUIRY_WEBHOOK_URL=
